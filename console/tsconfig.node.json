{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "src/design/vendor/tailwind.config.ts"]
}
